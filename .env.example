# ---- Prisma CLI ----
# Database thật là Cloudflare D1 (binding DB trong wrangler.jsonc). URL này chỉ để Prisma CLI chạy generate / migrate diff.
DATABASE_URL="file:./prisma/local-placeholder.db"

# ---- Auth.js ----
# Production: đặt bằng `npx wrangler secret put AUTH_SECRET`
AUTH_SECRET="thay-bang-chuoi-ngau-nhien (tạo bằng: openssl rand -base64 32)"
AUTH_TRUST_HOST="true"

# ---- Site ----
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Host ảnh ngoài được phép dùng với next/image (cách nhau dấu phẩy)
IMAGE_REMOTE_HOSTS=""
# ID Zalo Official Account (plugin chia sẻ Zalo chính thức; để trống dùng link chia sẻ thường)
NEXT_PUBLIC_ZALO_OA_ID=""

# ---- Ảnh (Cloudflare R2) ----
# URL công khai của bucket R2 (custom domain hoặc https://pub-xxxx.r2.dev). Để trống → ảnh được phục vụ qua /api/media/...
R2_PUBLIC_URL="https://pub-2e3adbbd2d98438786c5e3f525507a41.r2.dev"
MAX_UPLOAD_SIZE_MB="8"

R2_ACCOUNT_ID=d784ebdd9e1d3925e3c6a6ac52160bd3
R2_ACCESS_KEY_ID=43e526191aea6e2c42b90fb463a1303f
R2_SECRET_ACCESS_KEY=a3d1a41e501d0bd3d10b1f82dd6d331bfa48a0a26951afb77b33bda677a04ab0
R2_BUCKET_NAME=pd-imgs

# ---- Mật khẩu ----
# Số vòng PBKDF2 (giảm xuống 50000 nếu dùng Workers Free plan và gặp lỗi vượt CPU khi đăng nhập)
PASSWORD_HASH_ITERATIONS="100000"

# ---- Admin mặc định (dùng khi seed) ----
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="Admin@12345"

# ---- Chống spam (dự phòng khi không có binding LEAD_RATE_LIMITER) ----
RATE_LIMIT_MAX="5"
RATE_LIMIT_WINDOW_SECONDS="600"
