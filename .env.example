# ---- Auth.js ----
# Production: đặt bằng `npx wrangler secret put AUTH_SECRET`
AUTH_SECRET="thay-bang-chuoi-ngau-nhien (tạo bằng: openssl rand -base64 32)"
AUTH_TRUST_HOST="true"

# ---- Site ----
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Host ảnh ngoài được phép dùng với next/image (cách nhau dấu phẩy)
IMAGE_REMOTE_HOSTS=""
# ID Zalo Official Account (plugin chia sẻ Zalo chính thức; để trống dùng link chia sẻ thường)
NEXT_PUBLIC_ZALO_OA_ID=""

# ---- Ảnh (Cloudflare R2) ----
# URL công khai của bucket R2 (custom domain hoặc https://pub-xxxx.r2.dev). Để trống → ảnh được phục vụ qua /api/media/...
R2_PUBLIC_URL="https://pub-2e3adbbd2d98438786c5e3f525507a41.r2.dev"
MAX_UPLOAD_SIZE_MB="8"


# ---- Mật khẩu ----
# Số vòng PBKDF2 (50000 ≈ 4–8 ms CPU, phù hợp giới hạn 10 ms của Workers Free; mật khẩu cũ vẫn kiểm tra được vì số vòng lưu kèm hash)
PASSWORD_HASH_ITERATIONS="50000"

# ---- Admin mặc định (dùng khi seed) ----
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="Admin@12345"

# ---- Chống spam (dự phòng khi không có binding LEAD_RATE_LIMITER) ----
RATE_LIMIT_MAX="5"
RATE_LIMIT_WINDOW_SECONDS="600"
