// Prisma schema – Website công ty xuất khẩu lao động (Cloudflare D1 / SQLite)
// Sau khi sửa schema: `npm run db:migration -- ten-thay-doi` để sinh file SQL, rồi `npm run db:migrate` (local) / `npm run db:migrate:remote`.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "cloudflare"
  moduleFormat        = "esm"
  importFileExtension = ""
}

// Cloudflare D1 = SQLite. Migration SQL được sinh bằng `npm run db:migration -- <ten>` và áp dụng bằng wrangler.
datasource db {
  provider = "sqlite"
}

// ---------- ENUMS ----------

/// Vai trò tài khoản quản trị
enum Role {
  ADMIN  // Quản trị viên: toàn quyền, quản lý tài khoản
  EDITOR // Biên tập viên: chỉ quản lý nội dung
}

/// Trạng thái bài viết
enum PostStatus {
  DRAFT     // Nháp
  PUBLISHED // Đã xuất bản
  SCHEDULED // Hẹn giờ đăng (tự hiển thị khi publishedAt <= now)
}

/// Trạng thái đơn hàng tuyển dụng
enum JobStatus {
  OPEN   // Đang tuyển
  CLOSED // Đã đóng
}

/// Yêu cầu giới tính của đơn hàng
enum Gender {
  MALE
  FEMALE
  ANY
}

/// Loại đăng ký từ form công khai
enum LeadType {
  CONSULTATION // Đăng ký tư vấn
  APPLICATION  // Ứng tuyển đơn hàng
  CONTACT      // Liên hệ
}

/// Trạng thái xử lý đăng ký
enum LeadStatus {
  NEW       // Mới
  CONTACTED // Đã liên hệ
  PASSED    // Đã đỗ
  CANCELLED // Hủy
}

/// Loại chương trình du học / đào tạo
enum ProgramType {
  STUDY_ABROAD // Du học nghề
  LANGUAGE     // Khóa đào tạo tiếng
  VOCATIONAL   // Đào tạo kỹ năng nghề
}

// ---------- TÀI KHOẢN ----------

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         Role      @default(EDITOR)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  posts Post[]
  media Media[]
}

// ---------- BÀI VIẾT ----------

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  posts Post[]
}

model Tag {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  posts Post[]
}

model Post {
  id              String     @id @default(cuid())
  title           String
  slug            String     @unique
  excerpt         String?
  /// Nội dung HTML từ trình soạn thảo TipTap
  content         String     @default("")
  coverImage      String?
  status          PostStatus @default(DRAFT)
  /// Thời điểm xuất bản. Với bài hẹn giờ là thời điểm sẽ hiển thị.
  publishedAt     DateTime?
  isFeatured      Boolean    @default(false)
  viewCount       Int        @default(0)
  // SEO
  metaTitle       String?
  metaDescription String?
  ogImage         String?

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  authorId   String?
  author     User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  tags       Tag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publishedAt])
  @@index([categoryId])
}

// ---------- THỊ TRƯỜNG & ĐƠN HÀNG ----------

model Market {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  /// Mã quốc gia ISO-2 (JP, KR, TW, DE...) dùng để hiển thị cờ
  countryCode String?
  image       String?
  summary     String?
  /// Mô tả chi tiết (HTML)
  description String  @default("")
  /// Điều kiện tham gia (HTML)
  requirements String?
  salaryRange String?
  cost        String?
  duration    String?
  /// Ngành nghề phổ biến – mảng JSON dạng chuỗi (SQLite không có kiểu mảng), vd ["Cơ khí","Điện tử"]
  industries  String  @default("[]")
  /// Ưu điểm nổi bật – mảng JSON dạng chuỗi
  highlights  String  @default("[]")
  isFeatured  Boolean @default(false)
  isActive    Boolean @default(true)
  order       Int     @default(0)
  metaTitle       String?
  metaDescription String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  jobOrders JobOrder[]
  leads     Lead[]
}

model JobOrder {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  marketId    String
  market      Market    @relation(fields: [marketId], references: [id], onDelete: Restrict)
  industry    String
  quantity    Int       @default(1)
  gender      Gender    @default(ANY)
  ageMin      Int?
  ageMax      Int?
  /// Mức lương hiển thị, vd "160.000 – 180.000 Yên/tháng"
  salaryText  String?
  /// Mức lương quy đổi VNĐ/tháng để lọc
  salaryVnd   Int?
  cost        String?
  location    String?
  deadline    DateTime?
  interviewDate DateTime?
  departureNote String?
  /// Mô tả công việc (HTML)
  description  String  @default("")
  requirements String?
  benefits     String?
  image        String?
  status       JobStatus @default(OPEN)
  isFeatured   Boolean   @default(false)
  viewCount    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  leads Lead[]

  @@index([status, marketId])
  @@index([industry])
}

// ---------- ĐĂNG KÝ TƯ VẤN / ỨNG TUYỂN ----------

model Lead {
  id         String     @id @default(cuid())
  type       LeadType   @default(CONSULTATION)
  fullName   String
  phone      String
  email      String?
  birthYear  Int?
  hometown   String?
  marketId   String?
  market     Market?    @relation(fields: [marketId], references: [id], onDelete: SetNull)
  jobOrderId String?
  jobOrder   JobOrder?  @relation(fields: [jobOrderId], references: [id], onDelete: SetNull)
  message    String?
  status     LeadStatus @default(NEW)
  adminNote  String?
  /// Trang gửi form (để biết nguồn đăng ký)
  source     String?
  ipAddress  String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([status, createdAt])
}

// ---------- NỘI DUNG KHÁC ----------

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  /// Vd: "Thực tập sinh cơ khí – Osaka, Nhật Bản"
  position  String?
  content   String
  avatar    String?
  rating    Int      @default(5)
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Partner {
  id        String   @id @default(cuid())
  name      String
  logo      String?
  website   String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Banner {
  id        String   @id @default(cuid())
  title     String
  subtitle  String?
  image     String
  ctaText   String?
  ctaLink   String?
  ctaText2  String?
  ctaLink2  String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TrainingProgram {
  id        String      @id @default(cuid())
  title     String
  slug      String      @unique
  type      ProgramType @default(LANGUAGE)
  summary   String?
  /// Nội dung chi tiết (HTML)
  content   String      @default("")
  image     String?
  duration  String?
  tuition   String?
  order     Int         @default(0)
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

/// Thư viện ảnh đã upload (dùng lại được trong bài viết, banner...)
model Media {
  id           String   @id @default(cuid())
  url          String
  /// Khóa/đường dẫn trong storage để xóa file
  storageKey   String?
  filename     String
  mimeType     String
  size         Int
  width        Int?
  height       Int?
  alt          String?
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
}

/// Cài đặt chung – chỉ có 1 dòng (id = 1)
model Setting {
  id              Int     @id @default(1)
  companyName     String
  shortName       String?
  slogan          String?
  logo            String?
  licenseNumber   String?
  licenseIssuer   String?
  taxCode         String?
  hotline         String
  zalo            String?
  email           String?
  address         String?
  mapEmbedUrl     String?
  workingHours    String?
  facebook        String?
  youtube         String?
  tiktok          String?
  messenger       String?
  foundedYear     Int?
  statWorkers     Int?
  statYears       Int?
  statPartners    Int?
  statMarkets     Int?
  aboutShort      String?
  /// Nội dung trang giới thiệu (HTML)
  aboutContent    String?
  vision          String?
  mission         String?
  metaTitle       String?
  metaDescription String?
  ogImage         String?
  updatedAt       DateTime @updatedAt
}
